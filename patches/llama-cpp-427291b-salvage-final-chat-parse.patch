             return msg;
         }
         LOG_WRN("%s: unparsed %s output: %s\n", __func__, common_chat_format_name(params.format), effective_input.substr(result.end).c_str());
+        // A generation glitch (see ggml-org/llama.cpp#26381 and
+        // ggml-org/llama.cpp#20260) can leave a *final* (non-streaming) parse
+        // unable to match the grammar anywhere at all, from the very first
+        // byte onward, not just trailing off partway through. Salvage a final
+        // parse unconditionally instead of throwing: return whatever the AST
+        // captured (possibly nothing) plus the unparsed remainder as literal
+        // content, so a corrupted generation degrades the response instead of
+        // failing the request outright.
+        if (!is_partial) {
+            common_chat_msg msg;
+            msg.role = "assistant";
+            std::unique_ptr<common_chat_peg_mapper> mapper;
+            if (params.format == COMMON_CHAT_FORMAT_PEG_GEMMA4) {
+                mapper = std::make_unique<common_chat_peg_gemma4_mapper>(msg);
+            } else if (params.format == COMMON_CHAT_FORMAT_PEG_MINIMAX_M3) {
+                mapper = std::make_unique<common_chat_peg_minimax_m3_mapper>(msg);
+            } else {
+                mapper = std::make_unique<common_chat_peg_mapper>(msg);
+            }
+            mapper->from_ast(ctx.ast, result);
+            if (result.end < effective_input.size()) {
+                msg.content += effective_input.substr(result.end);
+            }
+
+            if (ctx.is_debug()) {
+                fprintf(stderr, "\nAST for final parse (fail):\n%s\n", ctx.ast.dump().c_str());
